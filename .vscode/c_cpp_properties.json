{
    "configurations": [
        {
            "name": "Linux",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            
            // 这里的 includePath 只留 workspaceFolder 即可，其他的全部删掉
            // 强迫插件去读 compile_commands.json，读不到就报错（反而能帮你发现编译问题）
            "includePath": [
                "${workspaceFolder}/**"
            ],
            
            "defines": [],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}