{
    "configurations": [
        {
            "name": "Linux",
            // 1. 告诉 VS Code 必须优先信赖编译数据库 (最快、最准)
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",

            // 2. includePath 只是备胎，当 compile_commands.json 还没生成，
            //    或者打开了一个没被编译的 .h 文件时才用。
            "includePath": [
                // "${workspaceFolder}/**",
                // "/opt/ros/noetic/include/**",
                // 这里的系统库不需要加 **，也不需要加具体路径
                // 因为 compile_commands.json 里已经包含了 -I/usr/include/pcl-1.10
                // 如果你发现找不到头文件，再手动把具体路径补回来，但不要加 **
                "/usr/include/pcl-1.10",
                "/usr/include/eigen3"
            ],
            
            "defines": [],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}